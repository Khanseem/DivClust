#!/bin/bash
#PBS -P personal-e0538389
#PBS -q auto
#PBS -N fmnist_c10cfg_k20_finalize
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k oed

set -euo pipefail
cd /scratch/e0538389/DivClust

source /scratch/e0538389/venv_divclust_pip/bin/activate
export PYTHONUNBUFFERED=1

bash artifacts/fmnist_divclust_vanda_cifar10cfg_k20_e100_2026-03-30/run_assets/collect_results.sh
python3 artifacts/fmnist_divclust_vanda_cifar10cfg_k20_e100_2026-03-30/run_assets/fmnist_c10cfg_k20_sweep_report.py \
  --artifact-dir artifacts/fmnist_divclust_vanda_cifar10cfg_k20_e100_2026-03-30

tar -czf artifacts/fmnist_divclust_vanda_cifar10cfg_k20_e100_2026-03-30/results_bundle.tar.gz \
  artifacts/fmnist_divclust_vanda_cifar10cfg_k20_e100_2026-03-30/results
