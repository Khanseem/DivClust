#!/bin/bash
#PBS -P personal-e0538389
#PBS -q auto
#PBS -N fmnist_c10cfg_k20_e100
#PBS -l select=1:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -k oed

set -euo pipefail
cd /scratch/e0538389/DivClust
mkdir -p logs

source /scratch/e0538389/venv_divclust_pip/bin/activate
export PYTHONUNBUFFERED=1

DT_SAFE=$(echo "${DT}" | tr '.' '_')
RUN_NAME="CC_FMNIST_C10CFG_K20_E100_DT_${DT_SAFE}"
LOG_FILE="logs/fmnist_c10cfg_k20_e100_dt_${DT_SAFE}.out"

echo "START $(date) DT=${DT} RUN_NAME=${RUN_NAME}" | tee "${LOG_FILE}"
python main.py \
  --preset cc_cifar10 \
  --dataset fashion_mnist \
  --dataset_path "./data_folder/FashionMNIST" \
  --group fashion_mnist_cifar10cfg_k20 \
  --backbone resnet34 \
  --proj_dim 128 \
  --optimizer adam \
  --lr 0.0003 \
  --weight_decay 0.0 \
  --epochs 100 \
  --eval_interval 10 \
  --crop_size 224 \
  --batch_size 256 \
  --clusters 10 \
  --clusterings 20 \
  --NMI_target "${DT}" \
  --NMI_interval 20 \
  --threshold_rate 0.99 \
  --divclust_mbank_size 10000 \
  --run_name "${RUN_NAME}" \
  --wandb_mode off \
  >> "${LOG_FILE}" 2>&1
echo "END $(date) DT=${DT} RUN_NAME=${RUN_NAME}" | tee -a "${LOG_FILE}"
