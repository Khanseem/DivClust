#!/bin/bash
#PBS -N divclust_fmnist_20e
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/divclust_fmnist_20e.out

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs

# Load your Vanda environment here (adjust if needed)
module purge
module unload PyTorch >/dev/null 2>&1 || true
module load torchvision/0.13.1-foss-2022a-CUDA-11.7.0
module load scikit-learn/1.1.2-foss-2022a
module load OpenCV/4.6.0-foss-2022a-CUDA-11.7.0-contrib
export PYTHONNOUSERSITE=1
module list

python3 main.py \
  --preset cc_fashionmnist \
  --dataset_path "${DATASET_PATH:-./data_folder/FashionMNIST}" \
  --epochs "${EPOCHS:-20}" \
  --gpu "${GPU:-0}" \
  --gpus "${GPU:-0}" \
  --wandb_mode off
