#!/bin/bash
#PBS -N fmnist_dt
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:30:00
#PBS -j oe

set -euo pipefail

DT="${DT:?DT is required}"
DT_SAFE="$(echo "${DT}" | tr '.' '_')"
RUN_NAME="CC_FMNIST_E20_DT_${DT_SAFE}"

cd "$PBS_O_WORKDIR"
mkdir -p hpc_results/vanda/logs_fashionmnist

module purge
export PYTHONNOUSERSITE=1
PYTHON_BIN="${PYTHON_BIN:-$HOME/.conda/miniconda/4.9/envs/divclust/bin/python}"

"${PYTHON_BIN}" main.py \
  --preset cc_fashionmnist \
  --dataset_path "${DATASET_PATH:-./data_folder/FashionMNIST}" \
  --epochs "${EPOCHS:-20}" \
  --gpu "${GPU:-0}" \
  --gpus "${GPU:-0}" \
  --NMI_target "${DT}" \
  --run_name "${RUN_NAME}" \
  --wandb_mode off \
  > "hpc_results/vanda/logs_fashionmnist/${RUN_NAME}.out" 2>&1

"${PYTHON_BIN}" analyze_divclust_run.py \
  --experiment-dir "./experiments/deep_clustering/${RUN_NAME}"
